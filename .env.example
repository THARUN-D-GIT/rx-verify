# Copy this file to .env and fill in local values.
# Public Supabase settings are exposed to the browser when prefixed with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never use the VITE_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
